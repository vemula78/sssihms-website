{"context":"et_builder","data":{"1":"[et_pb_section fb_built=\"1\" _builder_version=\"4.27.0\" custom_padding=\"0px||0px||true|false\" background_color=\"#ffffff\"][et_pb_row _builder_version=\"4.27.0\" width=\"100%\" max_width=\"100%\" custom_padding=\"0px|0px|0px|0px|true|true\" custom_margin=\"0px|0px|0px|0px|true|true\"][et_pb_column type=\"4_4\" _builder_version=\"4.27.0\"][et_pb_code admin_label=\"SSSIHMS — Combined Statistics\" _builder_version=\"4.27.0\"]<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js\"></script><!-- [et_pb_line_break_holder] --><style><!-- [et_pb_line_break_holder] -->#ssdash-combined{<!-- [et_pb_line_break_holder] --> --navy:#1A2A4F; --blue:#1A5276; --card:#C0392B; --ctvs:#1A5276; --nesu:#E67E22; --ms:#27AE60;<!-- [et_pb_line_break_holder] --> --ink:#1c2733; --muted:#6b7785; --line:#e4e9ef; --bg:#f4f6f9; --panel:#ffffff;<!-- [et_pb_line_break_holder] -->}#ssdash-combined *{box-sizing:border-box;margin:0;padding:0}#ssdash-combined{font-family:-apple-system,'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.45}#ssdash-combined .wrap{max-width:1280px;margin:0 auto;padding:0 24px 64px}#ssdash-combined header{background:linear-gradient(135deg,var(--navy),#24406e);color:#fff;padding:34px 0 30px;margin-bottom:28px}#ssdash-combined header .wrap{padding-bottom:0}#ssdash-combined .eyebrow{font-size:12px;letter-spacing:2.5px;text-transform:uppercase;color:#aebfdd;font-weight:600}#ssdash-combined h1{font-size:30px;font-weight:700;margin:6px 0 4px}#ssdash-combined .sub{color:#c5d2ea;font-size:14px}#ssdash-combined .grand{display:flex;align-items:baseline;gap:16px;margin-top:20px;flex-wrap:wrap}#ssdash-combined .grand .num{font-size:54px;font-weight:800;color:#f4b860;line-height:1}#ssdash-combined .grand .lbl{font-size:14px;color:#c5d2ea;max-width:360px}#ssdash-combined section{margin-top:34px}#ssdash-combined h2{font-size:17px;font-weight:700;color:var(--navy);margin-bottom:14px;padding-bottom:8px;border-bottom:2px solid var(--line)}#ssdash-combined .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}#ssdash-combined .kpi{background:var(--panel);border-radius:12px;padding:18px 18px 16px;box-shadow:0 1px 3px rgba(20,40,80,.07);border-top:4px solid var(--blue)}#ssdash-combined .kpi.card{border-top-color:var(--card)}#ssdash-combined .kpi.ctvs{border-top-color:var(--ctvs)}#ssdash-combined .kpi.nesu{border-top-color:var(--nesu)}#ssdash-combined .kpi.ms{border-top-color:var(--ms)}#ssdash-combined .kpi .dept{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted)}#ssdash-combined .kpi .big{font-size:34px;font-weight:800;margin:6px 0 2px}#ssdash-combined .kpi .meta{font-size:12.5px;color:var(--muted)}#ssdash-combined .kpi .row{display:flex;justify-content:space-between;font-size:12.5px;margin-top:9px;padding-top:9px;border-top:1px solid var(--line);color:#445}#ssdash-combined .kpi .row b{color:var(--ink)}#ssdash-combined .grid2{display:grid;grid-template-columns:1.4fr 1fr;gap:20px}#ssdash-combined .panel{background:var(--panel);border-radius:12px;padding:18px 20px 20px;box-shadow:0 1px 3px rgba(20,40,80,.07)}#ssdash-combined .panel h3{font-size:14px;color:var(--navy);margin-bottom:10px;font-weight:700}#ssdash-combined .chartbox{position:relative;height:300px}#ssdash-combined .chartbox.tall{height:340px}#ssdash-combined .controls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}#ssdash-combined .btn{border:1px solid var(--line);background:#fff;border-radius:20px;padding:6px 14px;font-size:13px;cursor:pointer;color:#445;font-weight:600}#ssdash-combined .btn.active{background:var(--navy);color:#fff;border-color:var(--navy)}#ssdash-combined table{width:100%;border-collapse:collapse;font-size:13px}#ssdash-combined th,#ssdash-combined td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line)}#ssdash-combined th{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted)}#ssdash-combined td.n{text-align:right;font-variant-numeric:tabular-nums}#ssdash-combined .tabs{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}#ssdash-combined .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px}#ssdash-combined .note{font-size:12px;color:var(--muted);margin-top:10px;font-style:italic}#ssdash-combined footer{margin-top:40px;font-size:12px;color:var(--muted);border-top:1px solid var(--line);padding-top:16px}@media(max-width:880px){#ssdash-combined .kpis{grid-template-columns:repeat(2,1fr)}#ssdash-combined .grid2{grid-template-columns:1fr}}<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->#ssdash-combined{width:100%;overflow-x:hidden}<!-- [et_pb_line_break_holder] --></style><!-- [et_pb_line_break_holder] --><div id=\"ssdash-combined\"><!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] --><header><!-- [et_pb_line_break_holder] --> <div class=\"wrap\"><!-- [et_pb_line_break_holder] -->  <div class=\"eyebrow\">SSSIHMS Whitefield · Sri Sathya Sai Institute of Higher Medical Sciences</div><!-- [et_pb_line_break_holder] -->  <h1>Combined Clinical Activity Dashboard</h1><!-- [et_pb_line_break_holder] -->  <div class=\"sub\">Cardiology · Cardiac Surgery · Neurosurgery · Multi-Specialty Surgery &nbsp;|&nbsp; 2001–2026 &nbsp;|&nbsp; Compiled 18 Jun 2026</div><!-- [et_pb_line_break_holder] -->  <div class=\"grand\"><!-- [et_pb_line_break_holder] -->   <div class=\"num\" id=\"grandNum\">195,100</div><!-- [et_pb_line_break_holder] -->   <div class=\"lbl\">Total procedures &amp; cath-lab sessions across four departments over 26 calendar years.</div><!-- [et_pb_line_break_holder] -->  </div><!-- [et_pb_line_break_holder] --> </div><!-- [et_pb_line_break_holder] --></header><!-- [et_pb_line_break_holder] --><div class=\"wrap\"><!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] --><section><!-- [et_pb_line_break_holder] --> <h2>Department snapshot</h2><!-- [et_pb_line_break_holder] --> <div class=\"kpis\" id=\"kpis\"></div><!-- [et_pb_line_break_holder] --> <div class=\"note\">Cath Lab counted as sessions; surgical departments as procedure records. Acuity definitions differ by department (see notes).</div><!-- [et_pb_line_break_holder] --></section><!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] --><section><!-- [et_pb_line_break_holder] --> <h2>Activity over time</h2><!-- [et_pb_line_break_holder] --> <div class=\"panel\"><!-- [et_pb_line_break_holder] -->  <div class=\"controls\" id=\"trendCtl\"><!-- [et_pb_line_break_holder] -->   <button class=\"btn active\" data-m=\"line\">Per-department lines</button><!-- [et_pb_line_break_holder] -->   <button class=\"btn\" data-m=\"stack\">Stacked volume</button><!-- [et_pb_line_break_holder] -->  </div><!-- [et_pb_line_break_holder] -->  <div class=\"chartbox tall\"><canvas id=\"trendChart\"></canvas></div><!-- [et_pb_line_break_holder] -->  <div class=\"note\">2026 is partial (through June). Cath Lab complexity classification method changes in 2020 (HIS action-line).</div><!-- [et_pb_line_break_holder] --> </div><!-- [et_pb_line_break_holder] --></section><!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] --><section><!-- [et_pb_line_break_holder] --> <h2>Composition</h2><!-- [et_pb_line_break_holder] --> <div class=\"grid2\"><!-- [et_pb_line_break_holder] -->  <div class=\"panel\"><!-- [et_pb_line_break_holder] -->   <h3>Top procedures / case-mix by department</h3><!-- [et_pb_line_break_holder] -->   <div class=\"tabs\" id=\"procTabs\"></div><!-- [et_pb_line_break_holder] -->   <div class=\"chartbox\"><canvas id=\"procChart\"></canvas></div><!-- [et_pb_line_break_holder] -->  </div><!-- [et_pb_line_break_holder] -->  <div class=\"panel\"><!-- [et_pb_line_break_holder] -->   <h3>Share of total activity</h3><!-- [et_pb_line_break_holder] -->   <div class=\"chartbox\"><canvas id=\"shareChart\"></canvas></div><!-- [et_pb_line_break_holder] -->  </div><!-- [et_pb_line_break_holder] --> </div><!-- [et_pb_line_break_holder] --></section><!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] --><section><!-- [et_pb_line_break_holder] --> <h2>Demographics &amp; acuity</h2><!-- [et_pb_line_break_holder] --> <div class=\"grid2\"><!-- [et_pb_line_break_holder] -->  <div class=\"panel\"><!-- [et_pb_line_break_holder] -->   <h3>Sex distribution (where recorded)</h3><!-- [et_pb_line_break_holder] -->   <div class=\"chartbox\"><canvas id=\"sexChart\"></canvas></div><!-- [et_pb_line_break_holder] -->  </div><!-- [et_pb_line_break_holder] -->  <div class=\"panel\"><!-- [et_pb_line_break_holder] -->   <h3>Department summary</h3><!-- [et_pb_line_break_holder] -->   <table id=\"demoTable\"></table><!-- [et_pb_line_break_holder] -->   <div class=\"note\">All four departments now carry record-level demographics. Mean age and M:F derived from full source exports.</div><!-- [et_pb_line_break_holder] -->  </div><!-- [et_pb_line_break_holder] --> </div><!-- [et_pb_line_break_holder] --></section><!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] --><footer id=\"footer\"></footer><!-- [et_pb_line_break_holder] --></div><!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] --><script><!-- [et_pb_line_break_holder] -->const DEPTS={<!-- [et_pb_line_break_holder] --> \"Cardiology (Cath Lab)\":{c:\"#C0392B\",total:71483,k2l:\"Cath sessions\",k2:60945,k3l:\"Interventional\",k3:46454,acuity:\"56.6%\",acuityL:\"Complex (interv.)\",male:37282,female:23706,age:38.8,period:\"2001–2026\",cls:\"card\"},<!-- [et_pb_line_break_holder] --> \"Cardiac Surgery (CTVS)\":{c:\"#1A5276\",total:30837,k2l:\"Unique patients\",k2:24978,k3l:\"Complex cases\",k3:1672,acuity:\"5.6%\",acuityL:\"Complex\",male:17692,female:12105,age:28.5,period:\"2001–2025\",cls:\"ctvs\"},<!-- [et_pb_line_break_holder] --> \"Neurosurgery (NESU)\":{c:\"#E67E22\",total:41185,k2l:\"Unique patients\",k2:31489,k3l:\"Complex cases\",k3:16800,acuity:\"40.8%\",acuityL:\"Complex\",male:24859,female:15357,age:37.3,period:\"2001–2026\",cls:\"nesu\"},<!-- [et_pb_line_break_holder] --> \"Multi-Specialty Surgery\":{c:\"#27AE60\",total:51595,k2l:\"Since 1976 (GH)\",k2:51595,k3l:\"HIS-era 2012–25\",k3:17967,acuity:\"37.9%\",acuityL:\"Major (HIS)\",male:7755,female:10309,age:41.6,period:\"1976–2026\",cls:\"ms\"},<!-- [et_pb_line_break_holder] -->};<!-- [et_pb_line_break_holder] -->const YEARS=Array.from({length:26},(_,i)=>2001+i);<!-- [et_pb_line_break_holder] -->const YEARLY={<!-- [et_pb_line_break_holder] --> \"Cardiology (Cath Lab)\":{2001:1293,2002:1760,2003:1851,2004:1989,2005:2411,2006:2140,2007:3226,2008:3571,2009:3517,2010:3551,2011:3308,2012:3835,2013:3348,2014:3744,2015:3914,2016:3164,2017:2953,2018:2972,2019:3005,2020:959,2021:1955,2022:2911,2023:3238,2024:2853,2025:2718,2026:1297},<!-- [et_pb_line_break_holder] --> \"Cardiac Surgery (CTVS)\":{2001:1730,2002:1307,2003:1099,2004:1020,2005:1110,2006:1015,2007:1246,2008:1123,2009:1451,2010:1264,2011:1114,2012:1775,2013:1571,2014:1878,2015:1536,2016:1421,2017:1324,2018:1165,2019:1058,2020:398,2021:728,2022:1051,2023:1079,2024:984,2025:900,2026:490},<!-- [et_pb_line_break_holder] --> \"Neurosurgery (NESU)\":{2001:1633,2002:1279,2003:1295,2004:1234,2005:1091,2006:1196,2007:1400,2008:1464,2009:1652,2010:1693,2011:1751,2012:1793,2013:1907,2014:2011,2015:1960,2016:1842,2017:1894,2018:1784,2019:1820,2020:738,2021:1280,2022:1726,2023:1819,2024:1880,2025:2016,2026:1027},<!-- [et_pb_line_break_holder] --> \"Multi-Specialty Surgery\":{2001:0,2002:0,2003:0,2004:0,2005:0,2006:0,2007:0,2008:1124,2009:1019,2010:1067,2011:965,2012:1094,2013:1355,2014:1352,2015:1326,2016:1454,2017:1824,2018:2039,2019:2047,2020:705,2021:1650,2022:2813,2023:3206,2024:3524,2025:3324,2026:0},<!-- [et_pb_line_break_holder] -->};<!-- [et_pb_line_break_holder] -->const TOP={<!-- [et_pb_line_break_holder] --> \"Cardiology (Cath Lab)\":&#091;&#091;\"Coronary Angiography (CAG)\",15513&#093;,&#091;\"PTMC (mitral)\",14314&#093;,&#091;\"PTCA (coronary)\",13528&#093;,&#091;\"EP Study\",4173&#093;,&#091;\"Left/Right Heart Cath\",3055&#093;,&#091;\"Coronary PCI\",3011&#093;,&#091;\"RFA / Ablation\",2751&#093;,&#091;\"ASD Device Closure\",2276&#093;&#093;,<!-- [et_pb_line_break_holder] --> \"Cardiac Surgery (CTVS)\":&#091;&#091;\"Congenital open-heart\",10977&#093;,&#091;\"CABG\",7829&#093;,&#091;\"Valvular\",4369&#093;,&#091;\"Congenital closed\",3485&#093;,&#091;\"Other\",2005&#093;,&#091;\"Redo / re-explore\",417&#093;,&#091;\"Cardiac tumour\",204&#093;,&#091;\"Thoracic aortic\",200&#093;&#093;,<!-- [et_pb_line_break_holder] --> \"Neurosurgery (NESU)\":&#091;&#091;\"Lumbar discectomy\",3240&#093;,&#091;\"Lumbar lam+disc\",2648&#093;,&#091;\"Craniotomy frontal\",2411&#093;,&#091;\"Post. fossa cranio\",2400&#093;,&#091;\"Re-explore/revision\",1725&#093;,&#091;\"VP shunt\",1447&#093;,&#091;\"Transsphenoidal\",1408&#093;,&#091;\"Cranio pterional\",1117&#093;&#093;,<!-- [et_pb_line_break_holder] --> \"Multi-Specialty Surgery\":&#091;&#091;\"Obstetrics & Gynaecology\",13859&#093;,&#091;\"Ophthalmology\",10402&#093;,&#091;\"General Surgery\",8709&#093;,&#091;\"ENT\",8155&#093;,&#091;\"Orthopaedics\",5952&#093;,&#091;\"Urology\",2474&#093;,&#091;\"Plastic Surgery\",2044&#093;&#093;,<!-- [et_pb_line_break_holder] -->};<!-- [et_pb_line_break_holder] -->const fmt=n=>n.toLocaleString('en-IN');<!-- [et_pb_line_break_holder] -->const names=Object.keys(DEPTS);<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->// KPIs<!-- [et_pb_line_break_holder] -->document.getElementById('kpis').innerHTML=names.map(n=>{const d=DEPTS&#091;n&#093;;return `<!-- [et_pb_line_break_holder] --> <div class=\"kpi ${d.cls}\"><!-- [et_pb_line_break_holder] -->  <div class=\"dept\">${n}</div><!-- [et_pb_line_break_holder] -->  <div class=\"big\">${fmt(d.total)}</div><!-- [et_pb_line_break_holder] -->  <div class=\"meta\">${d.period}</div><!-- [et_pb_line_break_holder] -->  <div class=\"row\"><span>${d.k2l}</span><b>${fmt(d.k2)}</b></div><!-- [et_pb_line_break_holder] -->  <div class=\"row\"><span>${d.acuityL}</span><b>${d.acuity}</b></div><!-- [et_pb_line_break_holder] --> </div>`;}).join('');<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->const baseOpts={responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{boxWidth:12,font:{size:11}}}}};<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->// Trend chart<!-- [et_pb_line_break_holder] -->let trendChart;<!-- [et_pb_line_break_holder] -->function drawTrend(mode){<!-- [et_pb_line_break_holder] --> const ds=names.map(n=>({label:n,data:YEARS.map(y=>YEARLY&#091;n&#093;&#091;y&#093;??0),borderColor:DEPTS&#091;n&#093;.c,backgroundColor:DEPTS&#091;n&#093;.c+(mode==='stack'?'cc':'22'),fill:mode==='stack',tension:.3,pointRadius:mode==='stack'?0:2,borderWidth:2}));<!-- [et_pb_line_break_holder] --> const cfg={type:mode==='stack'?'line':'line',data:{labels:YEARS,datasets:ds},<!-- [et_pb_line_break_holder] -->  options:{...baseOpts,scales:{x:{stacked:mode==='stack',grid:{display:false}},y:{stacked:mode==='stack',title:{display:true,text:'Procedures / sessions'}}}}};<!-- [et_pb_line_break_holder] --> if(trendChart)trendChart.destroy(); trendChart=new Chart(document.getElementById('trendChart'),cfg);<!-- [et_pb_line_break_holder] -->}<!-- [et_pb_line_break_holder] -->drawTrend('line');<!-- [et_pb_line_break_holder] -->document.querySelectorAll('#trendCtl .btn').forEach(b=>b.onclick=()=>{<!-- [et_pb_line_break_holder] --> document.querySelectorAll('#trendCtl .btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');drawTrend(b.dataset.m);});<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->// Procedure chart with tabs<!-- [et_pb_line_break_holder] -->let procChart,curDept=names&#091;0&#093;;<!-- [et_pb_line_break_holder] -->document.getElementById('procTabs').innerHTML=names.map((n,i)=>`<button class=\"btn ${i?'':'active'}\" data-d=\"${n}\"><span class=\"dot\" style=\"background:${DEPTS&#091;n&#093;.c}\"></span>${n.split(' (')&#091;0&#093;}</button>`).join('');<!-- [et_pb_line_break_holder] -->function drawProc(n){<!-- [et_pb_line_break_holder] --> const rows=TOP&#091;n&#093;;<!-- [et_pb_line_break_holder] --> const cfg={type:'bar',data:{labels:rows.map(r=>r&#091;0&#093;),datasets:&#091;{data:rows.map(r=>r&#091;1&#093;),backgroundColor:DEPTS&#091;n&#093;.c,borderRadius:4}&#093;},<!-- [et_pb_line_break_holder] -->  options:{...baseOpts,indexAxis:'y',plugins:{legend:{display:false}},scales:{x:{title:{display:true,text:'Cases'}}}}};<!-- [et_pb_line_break_holder] --> if(procChart)procChart.destroy();procChart=new Chart(document.getElementById('procChart'),cfg);<!-- [et_pb_line_break_holder] -->}<!-- [et_pb_line_break_holder] -->drawProc(curDept);<!-- [et_pb_line_break_holder] -->document.querySelectorAll('#procTabs .btn').forEach(b=>b.onclick=()=>{<!-- [et_pb_line_break_holder] --> document.querySelectorAll('#procTabs .btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');drawProc(b.dataset.d);});<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->// Share donut<!-- [et_pb_line_break_holder] -->new Chart(document.getElementById('shareChart'),{type:'doughnut',<!-- [et_pb_line_break_holder] --> data:{labels:names,datasets:&#091;{data:names.map(n=>DEPTS&#091;n&#093;.total),backgroundColor:names.map(n=>DEPTS&#091;n&#093;.c),borderWidth:2,borderColor:'#fff'}&#093;},<!-- [et_pb_line_break_holder] --> options:{...baseOpts,cutout:'58%',plugins:{legend:{position:'bottom',labels:{boxWidth:12,font:{size:11}}},<!-- [et_pb_line_break_holder] -->  tooltip:{callbacks:{label:c=>` ${c.label}: ${fmt(c.raw)} (${(c.raw/195100*100).toFixed(1)}%)`}}}}});<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->// Sex chart<!-- [et_pb_line_break_holder] -->const sexDepts=names.filter(n=>DEPTS&#091;n&#093;.male);<!-- [et_pb_line_break_holder] -->new Chart(document.getElementById('sexChart'),{type:'bar',<!-- [et_pb_line_break_holder] --> data:{labels:sexDepts.map(n=>n.split(' (')&#091;0&#093;),datasets:&#091;<!-- [et_pb_line_break_holder] -->  {label:'Male',data:sexDepts.map(n=>DEPTS&#091;n&#093;.male),backgroundColor:'#2E6DB4'},<!-- [et_pb_line_break_holder] -->  {label:'Female',data:sexDepts.map(n=>DEPTS&#091;n&#093;.female),backgroundColor:'#E5739A'}&#093;},<!-- [et_pb_line_break_holder] --> options:{...baseOpts,scales:{x:{stacked:true,grid:{display:false}},y:{stacked:true}}}});<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->// Demo table<!-- [et_pb_line_break_holder] -->document.getElementById('demoTable').innerHTML=`<thead><tr><th>Department</th><th class=\"n\">Mean age</th><th class=\"n\">M:F</th><th class=\"n\">Acuity</th></tr></thead><tbody>`+<!-- [et_pb_line_break_holder] --> names.map(n=>{const d=DEPTS&#091;n&#093;;const mf=d.male?(d.male/d.female).toFixed(2)+':1':'n/r';return `<tr><td><span class=\"dot\" style=\"background:${d.c}\"></span>${n}</td><td class=\"n\">${d.age??'n/r'}</td><td class=\"n\">${mf}</td><td class=\"n\">${d.acuity}</td></tr>`;}).join('')+`</tbody>`;<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->document.getElementById('footer').innerHTML=\"Sources: Cath_Lab_Statistics (eHIS+HIS+Cath Register) · CTVS_Classified_Register · NESU_Statistics 2001–2026 (HIS export + ATHMA discharge summaries) · EM_ALL_MS_Surgery_Statistics. Departments span different windows and acuity definitions; totals are additive but unique-patient counts are not deduplicated across departments. 2026 partial through June.\";<!-- [et_pb_line_break_holder] --></script><!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] --></div>[/et_pb_code][/et_pb_column][/et_pb_row][/et_pb_section]"}}